<% layout("/layouts/boilerplate") %>
<!-- Hero Section -->
<section class="hero-section">

    <div class="hero-content">

        <p class="hero-tagline">
            Discover • Plan • Explore
        </p>

        <h1>
            Find Stays You'll Never Forget
        </h1>


       <div class="hero-search">

    <div class="search-box">

        <i class="fa-solid fa-magnifying-glass"></i>

        <input
            type="text"
            placeholder="Search destinations..."
        >

    </div>

    <button>
        Explore
    </button>

</div>

    </div>

</section>

<!-- Existing Listings -->
 <%- include("../includes/categories.ejs") %>

<!-- Listings Section -->

<section class="listings-section">

    <div class="container">

        <h2 class="listing-heading">
            Explore Stays
        </h2>

        <p class="listing-subheading">
            Discover hand-picked destinations from around the world.
        </p>

        <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">

            <% for(let listing of listings){ %>

                <div class="col">

                    <a href="/listings/<%= listing._id %>" class="listing-link">

                        <div class="card listing-card">

                            <div class="image-container">

                                <img
                                    src="<%= listing.image %>"
                                    class="card-img-top"
                                    alt="listing_image"
                                >

                                <!-- Wishlist -->
                                <div class="wishlist-icon">
                                    <i class="fa-regular fa-heart"></i>
                                </div>

                                <!-- Rating -->
                                <div class="rating-badge">
                                    ⭐ 4.8
                                </div>

                                <!-- Location -->
                                <div class="location-badge">
                                    📍 <%= listing.location %>
                                </div>

                            </div>

                            <div class="card-body">

                                <h5 class="listing-title">
                                    <%= listing.title %>
                                </h5>

                                <p class="listing-price">
                                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                                    <span>/ night</span>
                                </p>

                            </div>

                        </div>

                    </a>

                </div>

            <% } %>

        </div>

    </div>

</section>
  

   