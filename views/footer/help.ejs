<% layout("/layouts/boilerplate") -%>

<section class="help-page">

    <!-- Hero -->

    <div class="help-hero">

        <h1>Help Center</h1>

        <p>
            Find answers to the most frequently asked questions about ExploreEase.
        </p>

    </div>

    <!-- FAQ -->

    <div class="faq-card">

        <div class="accordion" id="helpAccordion">

            <!-- FAQ 1 -->

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq1"
                    >

                        How do I create a listing?

                    </button>

                </h2>

                <div
                    id="faq1"
                    class="accordion-collapse collapse show"
                    data-bs-parent="#helpAccordion"
                >

                    <div class="accordion-body">

                        Sign in to your account, click <strong>Add Listing</strong>,
                        fill in the property details and submit.

                    </div>

                </div>

            </div>

            <!-- FAQ 2 -->

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq2"
                    >

                        How can I edit my listing?

                    </button>

                </h2>

                <div
                    id="faq2"
                    class="accordion-collapse collapse"
                    data-bs-parent="#helpAccordion"
                >

                    <div class="accordion-body">

                        Open your listing and click the <strong>Edit</strong>
                        button to update its details.

                    </div>

                </div>

            </div>

            <!-- FAQ 3 -->

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq3"
                    >

                        How do I delete my listing?

                    </button>

                </h2>

                <div
                    id="faq3"
                    class="accordion-collapse collapse"
                    data-bs-parent="#helpAccordion"
                >

                    <div class="accordion-body">

                        Open your listing and click the
                        <strong>Delete</strong> button.

                    </div>

                </div>

            </div>

            <!-- FAQ 4 -->

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq4"
                    >

                        How do I submit a review?

                    </button>

                </h2>

                <div
                    id="faq4"
                    class="accordion-collapse collapse"
                    data-bs-parent="#helpAccordion"
                >

                    <div class="accordion-body">

                        Visit any listing, scroll to the Reviews section,
                        give a rating and write your review.

                    </div>

                </div>

            </div>

            <!-- FAQ 5 -->

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq5"
                    >

                        Is ExploreEase free to use?

                    </button>

                </h2>

                <div
                    id="faq5"
                    class="accordion-collapse collapse"
                    data-bs-parent="#helpAccordion"
                >

                    <div class="accordion-body">

                        Yes. ExploreEase is completely free for users
                        to explore listings and share reviews.

                    </div>

                </div>

            </div>

            <!-- FAQ 6 -->

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button
                        class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq6"
                    >

                        How can I contact ExploreEase?

                    </button>

                </h2>

                <div
                    id="faq6"
                    class="accordion-collapse collapse"
                    data-bs-parent="#helpAccordion"
                >

                    <div class="accordion-body">

                        Visit the Contact Us page and send us a message.
                        We'll respond as soon as possible.

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>ok give css
