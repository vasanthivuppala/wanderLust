<% layout("/layouts/boilerplate") -%>

<section class="privacy-page">

    <!-- Hero -->

    <div class="privacy-hero">

        <h1>Privacy Policy</h1>

        <p>
            Your privacy matters to us. This Privacy Policy explains how
            ExploreEase collects, uses, and protects your information.
        </p>

    </div>

    <!-- Content -->

    <div class="privacy-card">

        <div class="policy-section">

            <h3>
                <i class="fa-solid fa-user-shield"></i>
                Information We Collect
            </h3>

            <p>
                We collect basic information such as your name, email address,
                account details, and the listings or reviews you create on
                ExploreEase.
            </p>

        </div>

        <div class="policy-section">

            <h3>
                <i class="fa-solid fa-database"></i>
                How We Use Your Information
            </h3>

            <p>
                Your information is used to provide our services, improve user
                experience, manage listings, and maintain account security.
            </p>

        </div>

        <div class="policy-section">

            <h3>
                <i class="fa-solid fa-cookie-bite"></i>
                Cookies
            </h3>

            <p>
                ExploreEase may use cookies to remember your preferences,
                maintain your session, and enhance your browsing experience.
            </p>

        </div>

        <div class="policy-section">

            <h3>
                <i class="fa-solid fa-lock"></i>
                Data Security
            </h3>

            <p>
                We use reasonable security measures to protect your personal
                information from unauthorized access, disclosure, or misuse.
            </p>

        </div>

        <div class="policy-section">

            <h3>
                <i class="fa-solid fa-user-check"></i>
                Your Rights
            </h3>

            <p>
                You may update your profile information, remove your listings,
                or request account deletion at any time.
            </p>

        </div>

        <div class="policy-section">

            <h3>
                <i class="fa-solid fa-envelope"></i>
                Contact Us
            </h3>

            <p>
                If you have any questions regarding this Privacy Policy, please
                contact us through the Contact Us page.
            </p>

        </div>

    </div>

</section>